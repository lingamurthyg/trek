<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC
        "-//Apache Software Foundation//DTD Tiles Configuration 2.0//EN"
        "http://tiles.apache.org/dtds/tiles-config_2_0.dtd">
<!--
    Tiles 2 layout definitions.
    Currently only the master layout is wired up. The struts-config above forwards
    directly to JSPs that use <jsp:include> for the chrome -- ops never finished
    converting all of them. Mixed bag.
-->
<tiles-definitions>

    <definition name="cargotrak.master" template="/WEB-INF/jsp/layout/master.jsp">
        <put-attribute name="title" value="CargoTrak"/>
        <put-attribute name="header" value="/WEB-INF/jsp/layout/header.jsp"/>
        <put-attribute name="nav"    value="/WEB-INF/jsp/layout/nav.jsp"/>
        <put-attribute name="footer" value="/WEB-INF/jsp/layout/footer.jsp"/>
        <put-attribute name="body"   value=""/>
    </definition>

    <definition name="cargotrak.dashboard" extends="cargotrak.master">
        <put-attribute name="title" value="Dashboard"/>
        <put-attribute name="body"  value="/WEB-INF/jsp/dashboard.jsp"/>
    </definition>

</tiles-definitions>
