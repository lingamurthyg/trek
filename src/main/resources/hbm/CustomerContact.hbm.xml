<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="CustomerContact" table="customer_contacts">
        <id name="contactId" column="contact_id">
            <generator class="identity"/>
        </id>
        <many-to-one name="customer" class="Customer" column="customer_id" not-null="true" lazy="false"/>
        <property name="contactName" column="contact_name" length="255"/>
        <property name="title"       column="title"        length="255"/>
        <property name="email"       column="email"        length="255"/>
        <property name="phone"       column="phone"        length="255"/>
        <property name="primaryFlag" column="primary_flag" length="255"/>
    </class>

</hibernate-mapping>
