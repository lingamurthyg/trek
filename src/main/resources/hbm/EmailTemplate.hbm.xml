<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="EmailTemplate" table="email_templates">
        <id name="templateId" column="template_id">
            <generator class="identity"/>
        </id>
        <property name="templateCode" column="template_code" not-null="true" length="255"/>
        <property name="subject"      column="subject"       length="255"/>
        <property name="body"         column="body"          type="text"/>
    </class>

</hibernate-mapping>
