<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="InventoryItem" table="inventory_items">
        <id name="itemId" column="item_id">
            <generator class="identity"/>
        </id>
        <property name="sku"          column="sku"          length="255"/>
        <property name="description"  column="description"  length="255"/>
        <property name="zoneId"       column="zone_id"/>
        <property name="quantity"     column="quantity"/>
        <property name="weightKg"     column="weight_kg"    precision="15" scale="2"/>
        <property name="lastUpdated"  column="last_updated" type="timestamp"/>
    </class>

</hibernate-mapping>
