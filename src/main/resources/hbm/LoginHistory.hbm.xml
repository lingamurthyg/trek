<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="LoginHistory" table="login_history">
        <id name="loginId" column="login_id">
            <generator class="identity"/>
        </id>
        <property name="userId"      column="user_id"/>
        <property name="username"    column="username"     length="255"/>
        <property name="loginTime"   column="login_time"   type="timestamp"/>
        <property name="ipAddress"   column="ip_address"   length="255"/>
        <property name="successFlag" column="success_flag" length="255"/>
    </class>

</hibernate-mapping>
