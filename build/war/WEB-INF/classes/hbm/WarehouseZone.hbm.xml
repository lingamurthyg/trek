<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="WarehouseZone" table="warehouse_zones">
        <id name="zoneId" column="zone_id">
            <generator class="identity"/>
        </id>
        <many-to-one name="warehouse" class="Warehouse" column="warehouse_id" not-null="true" lazy="false"/>
        <property name="code"        column="code"        length="255"/>
        <property name="description" column="description" length="255"/>
    </class>

</hibernate-mapping>
