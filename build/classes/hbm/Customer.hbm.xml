<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="Customer" table="customers">
        <id name="customerId" column="customer_id">
            <generator class="identity"/>
        </id>
        <property name="customerCode"  column="customer_code" not-null="true" length="255"/>
        <property name="name"          column="name"          length="255"/>
        <property name="industry"      column="industry"      length="255"/>
        <property name="creditLimit"   column="credit_limit"  precision="15" scale="2"/>
        <property name="paymentTerms"  column="payment_terms" length="255"/>
        <property name="activeFlag"    column="active_flag"   length="255"/>
        <property name="createdDate"   column="created_date"  type="timestamp"/>

        <set name="contacts" inverse="true" lazy="false" cascade="all-delete-orphan">
            <key column="customer_id"/>
            <one-to-many class="CustomerContact"/>
        </set>
        <set name="addresses" inverse="true" lazy="false" cascade="all-delete-orphan">
            <key column="customer_id"/>
            <one-to-many class="CustomerAddress"/>
        </set>
    </class>

</hibernate-mapping>
