<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="Role" table="roles">
        <id name="roleId" column="role_id">
            <generator class="identity"/>
        </id>
        <property name="roleName"    column="role_name"  not-null="true" length="255"/>
        <property name="description" column="description" length="255"/>

        <set name="permissions" table="role_permissions" lazy="false" cascade="save-update">
            <key column="role_id"/>
            <many-to-many class="Permission" column="permission_id"/>
        </set>
    </class>

</hibernate-mapping>
