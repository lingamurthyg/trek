<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="PaymentAllocation" table="payment_allocations">
        <id name="allocationId" column="allocation_id">
            <generator class="identity"/>
        </id>
        <property name="paymentId" column="payment_id" not-null="true"/>
        <property name="invoiceId" column="invoice_id" not-null="true"/>
        <property name="amount"    column="amount"     precision="15" scale="2"/>
    </class>

</hibernate-mapping>
