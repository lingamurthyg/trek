<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="Permission" table="permissions">
        <id name="permissionId" column="permission_id">
            <generator class="identity"/>
        </id>
        <property name="permCode"    column="perm_code"    not-null="true" length="255"/>
        <property name="description" column="description"  length="255"/>
    </class>

</hibernate-mapping>
