<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.cargotrak.domain">

    <class name="Route" table="routes">
        <id name="routeId" column="route_id">
            <generator class="identity"/>
        </id>
        <property name="code"        column="code" not-null="true" length="255"/>
        <property name="name"        column="name" length="255"/>
        <property name="origin"      column="origin" length="255"/>
        <property name="destination" column="destination" length="255"/>

        <set name="segments" inverse="true" lazy="false" cascade="all-delete-orphan">
            <key column="route_id"/>
            <one-to-many class="RouteSegment"/>
        </set>
    </class>

</hibernate-mapping>
